# Environment variables for Knowledge Center website
# Copy this file to `.env` (for local dev) or `.env.production` as needed.
# Restart the dev server after changes.

# EmailJS Configuration (required for Contact form submissions)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_CLERK_PUBLISHABLE_KEY=pk_test_ZXRlcm5hbC1rcmlsbC03Ny5jbGVyay5hY2NvdW50cy5kZXYk

# Optional: Site metadata overrides
# VITE_SITE_NAME=Knowledge Center
# VITE_SITE_URL=https://example.com

# Backend API base URL for portal/auth/application endpoints
# VITE_API_BASE_URL=http://localhost:8080
