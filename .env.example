# Environment variables for Knowledge Center website
# Copy this file to `.env` (for local dev) or `.env.production` as needed.
# Restart the dev server after changes.

# Web3Forms API access key (required for Contact form submissions)
# Get one at: https://web3forms.com/
VITE_WEB3FORMS_ACCESS_KEY=

# Optional: Site metadata overrides
# VITE_SITE_NAME=Knowledge Center
# VITE_SITE_URL=https://example.com
